{
  "skill": "deep-research",
  "evals": [
    {
      "id": "eval-cli-missing-key",
      "description": "Ensure research.py fails gracefully when GEMINI_API_KEY is unset",
      "command": "env -u GEMINI_API_KEY uv run ~/.agents/skills/deep-research/scripts/research.py run 'Test prompt' --json",
      "expected_exit_code": 1,
      "assertions": [
        {
          "type": "stdout_contains_json_key",
          "key": "error",
          "matches": "GEMINI_API_KEY"
        }
      ]
    },
    {
      "id": "eval-cli-help",
      "description": "Ensure help command outputs subcommands cleanly",
      "command": "uv run ~/.agents/skills/deep-research/scripts/research.py --help",
      "expected_exit_code": 0,
      "assertions": [
        {
          "type": "stdout_contains",
          "substring": "start"
        },
        {
          "type": "stdout_contains",
          "substring": "poll"
        },
        {
          "type": "stdout_contains",
          "substring": "run"
        }
      ]
    }
  ]
}
